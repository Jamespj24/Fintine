# Balance AI Secrets

# 1. Gemini AI (Required for Vision)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Google Sheets (Optional - Defaults to Mock)
# Place credentials.json in backend/ folder
USE_MOCK_SHEETS=false

# 3. Email (Optional - Defaults to Mock)
SMTP_EMAIL=
SMTP_PASSWORD=
